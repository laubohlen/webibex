+@pytest.mark.django_db
+def test_animals_overview_links_to_own_images_for_observed_animal(
+    client, user_factory, animal_factory, ibex_image_factory
+):
+    """The owner-scoped 'view my own photos of this animal' page
+    (animal_images_owner_view) lost its only entry point when the
+    Identification tab's duplicated animal listing was removed. Guards
+    that the Animals tab provides a working replacement entry point."""
+    user = user_factory(username="mine_link_user")
+    animal = animal_factory(id_code="MINELNK1")
+    ibex_image_factory(owner=user, name="mine_link_img", animal=animal)
+    client.force_login(user)
+
+    response = client.get(reverse("animals"))
+    own_images_url = reverse("animal-own-images", kwargs={"oid": animal.id})
+
+    assert own_images_url in response.content.decode()
+
